<Project>
  <!-- Every Agent Framework / Foundry / AG-UI package is pinned exactly. Several are prerelease and their APIs
       still move, so upgrade deliberately and run the tests. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="[1.28.0]" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="[1.28.0]" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="[1.28.0]" />
    <PackageVersion Include="Microsoft.Agents.AI.Anthropic" Version="[1.28.0]" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="[1.28.0-preview.261106.1]" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="[1.28.0-preview.261106.1]" />
  </ItemGroup>
  <ItemGroup Label="Foundry and Azure">
    <PackageVersion Include="Azure.AI.Projects" Version="[3.0.0]" />
    <PackageVersion Include="Anthropic.Foundry" Version="[1.0.0]" />
    <PackageVersion Include="Azure.AI.AgentServer.Core" Version="[1.0.0-beta.30]" />
    <PackageVersion Include="Azure.Identity" Version="[1.21.0]" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="[3.64.0]" />
    <PackageVersion Include="Newtonsoft.Json" Version="[13.0.4]" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="[4.12.0]" />
  </ItemGroup>
  <ItemGroup Label="Observability and parsing">
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="[1.10.0]" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="[1.21.0]" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="[1.21.0]" />
    <PackageVersion Include="AngleSharp" Version="[1.11.0]" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="[4.0.3]" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[4.0.1]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[18.12.0]" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="[10.0.15]" />
  </ItemGroup>
</Project>
