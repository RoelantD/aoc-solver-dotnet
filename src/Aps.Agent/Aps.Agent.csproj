<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Explicit for the remote build (Oryx reads the csproj; the root props are copied in by the azd prepackage hook). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aps.Agent</RootNamespace>
    <AssemblyName>Aps.Agent</AssemblyName>
    <UserSecretsId>aps-agent</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Agents.AI.Anthropic" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Anthropic.Foundry" />
    <PackageReference Include="Azure.AI.AgentServer.Core" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aps.Agent.Tests" />
  </ItemGroup>
</Project>
