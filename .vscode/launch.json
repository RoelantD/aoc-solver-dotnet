{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "01 - Single Agent + Tool",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-sample-01",
            "program": "${workspaceFolder}/samples/01-single-agent-tool/bin/Debug/net10.0/Sample01.SingleAgentTool.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "02 - Workflow (Happy Path)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-sample-02",
            "program": "${workspaceFolder}/samples/02-workflow-handoff-approval/bin/Debug/net10.0/Sample02.WorkflowHandoffApproval.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "02 - Workflow (Handoff)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-sample-02",
            "program": "${workspaceFolder}/samples/02-workflow-handoff-approval/bin/Debug/net10.0/Sample02.WorkflowHandoffApproval.dll",
            "args": ["--simulate-failures", "2"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "03 - Workflow Checkpoints (New)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-sample-03",
            "program": "${workspaceFolder}/samples/03-workflow-checkpoints/bin/Debug/net10.0/Sample03.WorkflowCheckpoints.dll",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "03 - Workflow Checkpoints (Resume)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-sample-03",
            "program": "${workspaceFolder}/samples/03-workflow-checkpoints/bin/Debug/net10.0/Sample03.WorkflowCheckpoints.dll",
            "args": ["--resume"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}