# Dashboard configuration (copy to .env.local; Vite only exposes VITE_* variables to the browser).
# None of these are secrets: the client id and tenant id are public identifiers of the SPA app registration.

# Full AG-UI Invocations URL of the solver agent.
#   Local agent (no sign-in, no session affinity):
#     http://localhost:8088/invocations
#   Hosted agent on Microsoft Foundry:
#     {projectEndpoint}/agents/aps-solver/endpoint/protocols/invocations?api-version=v1
# A URL starting with http://localhost or http://127.0.0.1 skips Entra sign-in entirely.
VITE_AGENT_URL=http://localhost:8088/invocations

# Microsoft Entra app registration (single-page application, redirect URI = the dashboard origin,
# e.g. http://localhost:5175). Used only for a hosted agent; the token scope is https://ai.azure.com/.default.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
