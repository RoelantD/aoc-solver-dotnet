# Agentic Advent of Code Solver (.NET) - local configuration. Template: copy to .env and fill in (no secrets in this file).
# Load it into a terminal with:  . .\scripts\env.ps1   (sets every variable below except AOC_SESSION)
# The agent reads AOC_SESSION from this file directly when KEYVAULT_URI is not set.
# Values come from `azd env get-values -e aps`.

# --- Microsoft Foundry ---------------------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/proj-default
FOUNDRY_RESOURCE_NAME=<account>
WORKHORSE_DEPLOYMENT=gpt-6.1-sol
WORKHORSE_DISPLAY_NAME=GPT-6.1 Sol
ESCALATION_DEPLOYMENT=claude-opus-5-5
ESCALATION_DISPLAY_NAME=Claude Opus 5.5

# --- Sandbox: Azure Container Apps Dynamic Sessions (egress disabled) ------------------------------
SESSIONS_POOL_ENDPOINT=https://<region>.dynamicsessions.io/subscriptions/<sub>/resourceGroups/<rg>/sessionPools/<pool>

# --- Advent of Code (agent only; never sent to models, sandbox or browser) ------------------------
# Value of the "session" cookie after logging in at https://adventofcode.com.
AOC_SESSION=
AOC_CONTACT=<your email or handle>
APS_REPO_URL=https://github.com/RoelantD/aoc-solver-dotnet

# --- Local agent ---------------------------------------------------------------------------------
APS_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# --- Azure state (commented out: the local demo uses the in-memory store and AOC_SESSION above) ----
# Uncomment to make the local agent use the same Cosmos DB and Key Vault as the hosted agent
# (needs data-plane roles for your own account).
# COSMOS_ENDPOINT=https://<cosmos>.documents.azure.com:443/
# KEYVAULT_URI=https://<vault>.vault.azure.net/

# --- Pricing (USD per 1M tokens; 0 = cost not shown) ---------------------------------------------
WORKHORSE_PRICE_INPUT_PER_MTOK=0
WORKHORSE_PRICE_OUTPUT_PER_MTOK=0
ESCALATION_PRICE_INPUT_PER_MTOK=0
ESCALATION_PRICE_OUTPUT_PER_MTOK=0

# --- Hosted agent (reference; used by scripts/preflight.ps1 and the dashboard) -------------------
# AGENT_APS_SOLVER_INVOCATIONS_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/proj-default/agents/aps-solver/endpoint/protocols/invocations?api-version=v1
# AGENT_IDENTITY_PRINCIPAL_ID=<agent identity principal id>
